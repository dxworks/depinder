{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "depinder-core",
  "projectType": "library",
  "sourceRoot": "packages/depinder-core/src",
  "tags": ["scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "outputs": ["{projectRoot}/dist"],
      "options": {"script": "build"}
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": {"script": "typecheck"}
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {"cwd": "{projectRoot}", "command": "eslint src test"}
    },
    "test": {
      "executor": "nx:run-script",
      "options": {"script": "test"}
    }
  }
}
