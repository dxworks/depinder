SERVER_SSH_ALIAS=depinder
APP_DIR=/opt/depinder
SERVER_SWAP_GB=4

SITE_ADDRESS=:80

# Session pooler string (port 5432), as in the root .env.example.
DATABASE_URL=postgresql://<user>:<password>@<pooler host>:5432/postgres
DATABASE_SSL=true
DATABASE_LISTEN=true
DATABASE_POOL_SIZE=32
API_POOL_SIZE=8

RESOLVER_API_TOKEN=
LOG_LEVEL=info

FETCH_CONCURRENCY=64
PAYLOAD_CACHE_MAX_PACKAGES=50000

VULN_MAX_SCANS=1
VULN_MAX_QUEUED=4
VULN_MAX_PURLS=5000
VULN_CPUS=1.5
VULN_MEM_LIMIT=2500m
