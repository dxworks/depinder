# depinder-server configuration. Copy to .env and fill in.

# --- required ---------------------------------------------------------------

# Postgres connection string. With Supabase use the DIRECT or SESSION POOLER
# string (port 5432), not the transaction pooler on 6543: migrations and the
# `FOR UPDATE SKIP LOCKED` queue need session semantics.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Bearer token every API call must present. Minimum 16 characters; the server
# refuses to start without it. Generate one with: openssl rand -hex 32
RESOLVER_API_TOKEN=change-me-to-at-least-16-chars

# --- optional ---------------------------------------------------------------

# TLS to Postgres. true (default) connects with ssl.rejectUnauthorized=false,
# which is what Supabase's shared certificate needs. Set to false for a local
# plaintext Postgres.
DATABASE_SSL=true

# resolver (default) = the api and the worker in one process. vuln = the
# vulnerability server (docs/vuln-server.md). Under docker compose, ROLE, PORT
# and the VULN_* settings come from docker-compose.yml and win over this file;
# both containers read this file for the token.
ROLE=resolver

PORT=8080

# debug | info (default) | warn | error
LOG_LEVEL=info

# Package fetches the demand-fill worker keeps in flight at once. The default sits
# just above what the per-ecosystem limiters add up to; lower it to be gentler on
# the registries. Pairs with DATABASE_POOL_SIZE, see docs/configuration.md.
FETCH_CONCURRENCY=64

# Postgres connections this process opens at most. 15 fits a stock Supabase session
# pooler, which refuses connections past its Pool Size; raise that pooler setting
# (or connect directly) and then set 32. Why: docs/configuration.md.
DATABASE_POOL_SIZE=15

# The api's share of DATABASE_POOL_SIZE (the worker gets the rest); must be smaller
# than it. 8 covers the chunks one depinder run posts at once. Why:
# docs/configuration.md.
API_POOL_SIZE=8

# Packages whose version tuples the api keeps in memory, reused only while their
# `package` row's `fetched_at` is unchanged, so it is safe with several instances.
# 0 switches it off.
PAYLOAD_CACHE_MAX_PACKAGES=50000

# Days of fetch_log (every upstream request the worker made) to keep, 1 to 365.
# The worker's ten-minute sweep deletes older rows.
FETCH_LOG_RETENTION_DAYS=3
