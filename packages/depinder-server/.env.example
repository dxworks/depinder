# depinder-server-side configuration. Copy to .env and fill in.

# --- required ---------------------------------------------------------------

# Postgres connection string. With Supabase use the DIRECT or SESSION POOLER
# string (port 5432), not the transaction pooler on 6543: migrations and the
# `FOR UPDATE SKIP LOCKED` queue need session semantics.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Bearer token every API call must present. Minimum 16 characters; the server
# refuses to start without it. Generate one with: openssl rand -hex 32
RESOLVER_API_TOKEN=change-me-to-at-least-16-chars

# --- optional ---------------------------------------------------------------

# TLS to Postgres. true (default) connects with ssl.rejectUnauthorized=false,
# which is what Supabase's shared certificate needs. Set to false for a local
# plaintext Postgres.
DATABASE_SSL=true

# One connection per process, outside DATABASE_POOL_SIZE, that LISTENs for
# fetch_queued and package_settled notifications: how an api and a worker in
# different processes hear each other without waiting for a poll. Count it
# against the pooler's Pool Size. false = polling only.
DATABASE_LISTEN=true

# api = HTTP only, worker = demand-fill + feeds only, all = both (default).
# vuln = the vulnerability server (README "Vulnerabilities"). Under docker
# compose, ROLE, PORT and the VULN_* settings come from docker-compose.yml and
# win over this file; both containers read this file for the token.
ROLE=all

PORT=8080

# debug | info (default) | warn | error
LOG_LEVEL=info

# Package fetches the demand-fill worker keeps in flight at once. The default
# sits just above the ~49 concurrent requests the per-ecosystem limiters in
# http.ts add up to, so those limiters — not this pool — stay the constraint on
# every registry. Lower it to be gentler overall; raising it past ~64 only adds
# packages queued behind a limiter.
FETCH_CONCURRENCY=64

# Postgres connections this process opens at most. The other half of a fill:
# the setting above fetches, these write. The database is hosted, so every
# statement is a round trip, and a package waiting here for a client is a fetch
# slot standing still — a pool of 10 was what held a 64-slot fill to an
# effective 4.4 requests in flight. A package spends about as long writing (five
# statements) as it does fetching, so half of FETCH_CONCURRENCY — 32 — is what
# it takes for this never to be the constraint.
#
# The default is lower than that because of the pooler. A Supabase SESSION
# pooler serves its own "Pool Size" and refuses everything past it outright
# (EMAXCONNSESSION — it does not queue), and a stock project's Pool Size is 15,
# for this whole process, api role and migrations included. Raise it under
# Dashboard > Settings > Database > Connection pooling, or connect directly,
# and then set this to 32.
DATABASE_POOL_SIZE=15

# How many of DATABASE_POOL_SIZE belong to the api alone. Carved out of it, never added to it: the
# ceiling that matters is the pooler's and it counts the whole process, so with the defaults the
# api gets 8 connections and the worker the remaining 7 — 15 in total, as before.
#
# Two pools rather than one because of what one pool did. A fill keeps FETCH_CONCURRENCY writes
# going at once, so the worker holds every client there is, and pg does not queue a waiter
# indefinitely: a request's query sits in the pending queue and is then rejected with "timeout
# exceeded when trying to connect" — an HTTP 500 for a caller who did nothing wrong. With a pool of
# its own the api has its own queue and the worker cannot reach into it.
#
# Eight is what a depinder run asks for at once: it posts every chunk together, up to 2,000 purls
# each (six for a 10,000-purl run), and never retries one, so a chunk that cannot get a client in
# time is lost to the registries. A chunk holds a client for one query at a time and never for the
# length of its stream, but on a cold cache those queries take seconds each, and four clients for six
# chunks was enough to lose one. It only applies to ROLE=all; a process running one
# role gets the whole of DATABASE_POOL_SIZE for it. With ROLE=all it must leave the worker at least
# one connection, so it has to be smaller than DATABASE_POOL_SIZE.
API_POOL_SIZE=8

# Packages whose version tuples the api keeps in memory, so a second request for
# a package it already answered needs no query. Every request still reads the
# `package` row, and an entry is used only when that row's `fetched_at` is
# exactly the one it was stored under — the worker stamps a new one in the same
# transaction that replaces a package's versions — so this is safe with several
# instances and correctness never depends on it. 0 switches it off.
PAYLOAD_CACHE_MAX_PACKAGES=50000
