{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    // esbuild builds the CommonJS bundle; tsc only checks, resolving @depinder/core's ESM `exports` as a bundler does
    "module": "preserve",
    "moduleResolution": "bundler",
    // Typecheck and tests read @depinder/core from its TypeScript sources; the build reads its dist
    "customConditions": ["depinder-source"],
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "__tests__"]
}
