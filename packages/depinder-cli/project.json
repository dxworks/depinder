{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "depinder-cli",
  "projectType": "application",
  "sourceRoot": "packages/depinder-cli/src",
  "tags": ["scope:client"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["rm -rf dist", "tsc -p tsconfig.build.json"],
        "parallel": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {"cwd": "{projectRoot}", "command": "tsc -p tsconfig.json"}
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {"cwd": "{projectRoot}", "command": "eslint src"}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {"cwd": "{projectRoot}", "command": "jest --passWithNoTests"}
    },
    "docs": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/site"],
      "options": {"cwd": "{projectRoot}", "command": "mkdocs build --strict --site-dir site"}
    }
  }
}
