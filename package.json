{
  "name": "depinder-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The depinder monorepo: the depinder CLI and, later, the shared core and the resolver server",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t typecheck lint test build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nx/esbuild": "23.2.1",
    "@nx/js": "23.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "nx": "23.2.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
